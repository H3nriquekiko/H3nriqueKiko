@page
@model Checklist.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Início";
}

<div class="card">
    <h1>Bem-vindo ao Checklist</h1>
    <p>Escolha uma opção para continuar:</p>
    <ul>
        <li><a asp-page="/Today">Hoje</a></li>
        <li><a asp-page="/Admin/Checklists">Administração</a></li>
        <li><a asp-page="/History">Histórico</a></li>
        <li>
            <form method="post" asp-page="/Account/Logout">
                @Html.AntiForgeryToken()
                <button type="submit" class="link-button">Sair</button>
            </form>
        </li>
    </ul>
</div>
